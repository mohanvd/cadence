---
import Hero from '../components/Hero';
import AppPreview from '../components/AppPreview';
import FeatureBento from '../components/FeatureBento';
import MusicLibrary from '../components/MusicLibrary';
import ShortcutStrip from '../components/ShortcutStrip';
import CapabilityList from '../components/CapabilityList';
import Assurances from '../components/Assurances';
import Closing from '../components/Closing';
import Footer from '../components/Footer';
import Mark from '../components/Mark';
import { REPO_URL, INSTALLER_URL, resolveInstallerSize } from '../links';

// The tokens, the faces and the document; then everything this page draws.
import '../styles/base.css';
import '../styles/landing.css';

// Asked once, here, at build time. The hero states it, the closing repeats it,
// and nothing else needs it.
const installerSize = await resolveInstallerSize();

// The brand's one-sentence description, which is also the line search results
// and link previews show. See brand/README.md.
const title = 'Cadence: everything plays';
const description =
  'A keyboard-first media player for Windows. Plays the MKV, HEVC and FLAC files other players hand back, and keeps your music library in the same quiet window. Free.';
const site = 'https://cadence.auva.dev';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0A09" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!--
      Paints the ground before the stylesheet arrives, so the first frame is not
      a white flash.
    -->
    <style>
      html,
      body {
        background-color: #0b0a09;
        margin: 0;
        padding: 0;
        min-height: 100vh;
      }
    </style>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cadence" />
    <meta property="og:url" content={site} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${site}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cadence. Everything plays. A keyboard-first media player for Windows." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/og-image.png`} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Cadence',
      operatingSystem: 'Windows 10, Windows 11',
      applicationCategory: 'MultimediaApplication',
      description,
      url: site,
      softwareVersion: __APP_VERSION__,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      author: { '@type': 'Person', name: 'Mohanad Tarek' },
      publisher: { '@type': 'Organization', name: 'Auva', url: 'https://auva.dev' },
    })} />
  </head>

  <body>
    <!--
      No `client:` directive on any of these. They are rendered here, once, and
      the page ships as HTML and CSS.
    -->
    <a class="skip" href="#main">Skip to content</a>

    <nav class="nav" aria-label="Main">
      <a class="lockup" href="#top" aria-label="Cadence">
        <Mark size={22} cut="small" />
        <span class="lockup__word">Cadence</span>
      </a>

      <!--
        Hidden on narrow viewports rather than folded into a menu button: three
        in-page anchors are not worth a drawer, and a drawer is not worth the
        JavaScript this page does not otherwise ship.
      -->
      <div class="nav__links">
        <a class="nav__link" href="#features">Features</a>
        <a class="nav__link" href="#music">Music</a>
        <a class="nav__link" href="#keyboard">Keyboard</a>
      </div>

      <div class="nav__actions">
        <a class="nav__link nav__link--repo" href={REPO_URL}>GitHub</a>
        <a class="button button--primary button--sm" href={INSTALLER_URL}>Download</a>
      </div>
    </nav>

    <main class="page" id="main">
      <!--
        The hero's light, and the only coloured thing above the fold besides the
        mark. Behind the column rather than inside it: it has to run wider than
        the measure and under the window.
      -->
      <div class="aura" aria-hidden></div>

      <div class="column" id="top">
        <Hero installerSize={installerSize} />
        <AppPreview />
        <FeatureBento />
        <MusicLibrary />
        <ShortcutStrip />
        <CapabilityList />
        <Assurances />
        <Closing installerSize={installerSize} />
      </div>
      <Footer />
    </main>
  </body>
</html>
