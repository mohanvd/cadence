# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Vercel
.vercel
.env
.env.*
!.env.example

# Rust / Tauri build output
src-tauri/target/
src-tauri/gen/schemas/

# The Android project is committed: it holds the manifest, the Kotlin entry
# point and, before long, the playback plugin, all of which are ours to edit.
# What Gradle makes from it is not.
src-tauri/gen/android/.gradle/
src-tauri/gen/android/build/
src-tauri/gen/android/app/build/
src-tauri/gen/android/app/.cxx/
src-tauri/gen/android/local.properties
src-tauri/gen/apple/

# Android signing. The upload key is what proves a release came from us, and a
# leaked one cannot be replaced without Google's help.
*.jks
*.keystore
keystore.properties

# FFmpeg, fetched by `npm run fetch:ffmpeg` rather than committed. It is 138MB
# of somebody else's build output, and a checked-in copy goes stale the moment
# upstream fixes a decoder. The build needs it present; CI fetches it too.
src-tauri/ffmpeg/
src-tauri/.ffmpeg-download/

# Updater signing keys. The private key is the one secret that cannot be
# rotated quietly: every installed copy of Cadence has the matching public key
# compiled into it, so losing control of this file means losing the update
# channel for everyone already running it. It belongs outside the repository;
# this pattern is only here to catch a stray copy.
*.key
!**/*.key.pub

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env*

# Astro
site/dist/
site/.astro/
site/node_modules/

# Local tooling for whoever is working on this, not part of the project.
.claude/
